{erl_opts, [debug_info]}.
{deps, [
    {rustler, "~> 0.30.0"},
    {snappyer, "1.2.9"},
    {brod, "~> 3.17.0"}
]}.

{plugins, [
    rebar_mix, 
    rebar3_rustler
]}.

{rustler_crates, [
    {compiler_engine, [{path, "native/compiler_engine"}, {mode, release}]}
]}.

%% THE FIX: Strip "warnings_as_errors" from strict older dependencies
{overrides, [
    {del, brod, [{erl_opts, [warnings_as_errors]}]},
    {del, supervisor3, [{erl_opts, [warnings_as_errors]}]}
]}.
